<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"

    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"


    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".About">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#396D28"
        android:layout_marginBottom="-50dp"
        android:paddingBottom="30dp"
        android:requiresFadingEdge="vertical"
        >


        <TextView
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:text="WorldFix Lite"

            android:textColor="@color/white"
            android:textSize="24dp"
            android:textStyle="bold" />

        <Button
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:text="signin"
            android:layout_marginLeft="-210dp"
            android:backgroundTint="#298932"
            android:layout_marginTop="-7dp"

            android:id="@+id/signinbutton"

            />

        <Button
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:text="signup"
            android:layout_marginLeft="10dp"
            android:backgroundTint="#298932"
            android:layout_marginTop="-7dp"

            android:id="@+id/signupbutton"

            />

    </LinearLayout>




    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >


        <androidx.cardview.widget.CardView
            android:layout_width="409dp"
            android:layout_height="wrap_content"

            android:orientation="vertical"
            app:cardBackgroundColor="@color/white"





            android:layout_marginRight="2dp"
            app:cardElevation="-200dp"

            android:layout_marginTop="20dp"
            app:cardCornerRadius="50dp"
            >

            <EditText

                android:layout_width="340dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="27dp"
                android:hint="Search issues..."
                android:textColorHint="#878585"
                android:layout_marginTop="20dp"

                android:paddingStart="20dp"
                android:drawableStart="@drawable/search"
                android:background="@drawable/edittext"
                android:paddingTop="18dp"
                android:drawableTint="#664D504D"

                android:id="@+id/search_bar"

                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="776dp"

                android:orientation="horizontal">


                <Button
                    android:id="@+id/post_problem"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="70dp"
                    android:backgroundTint="#1A6D21"
                    android:text="Post a problem"
                    android:textColor="@color/white"

                    android:textSize="9sp"

                    />

                <Button
                    android:id="@+id/solve_problem"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="40dp"
                    android:layout_marginTop="70dp"
                    android:backgroundTint="#1A6D21"
                    android:text="Solve a problem"
                    android:textColor="@color/white"

                    android:textSize="9dp"

                    />


            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="370dp"
                android:layout_marginLeft="15dp"
                android:layout_height="100dp"
                android:layout_marginTop="120dp"
                app:cardCornerRadius="10dp"


                app:cardBackgroundColor="#395D28"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="20dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="20dp"
                    android:text="Welcome back!"
                    android:textStyle="normal"
                    android:fontFamily="sans-serif-medium"



                    />
                <ImageView
                    android:layout_width="100dp"
                    android:layout_marginLeft="255dp"
                    android:layout_height="100dp"
                    android:background="@drawable/world"

                    android:scaleType="fitCenter"

                    />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="15dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="49dp"
                    android:text="Lets make the world better"
                    android:textStyle="normal"
                    android:fontFamily="sans-serif-medium"



                    />







            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Overview"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginTop="230dp"
                android:layout_marginLeft="20dp"


                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="590dp"
                android:backgroundTint="#fff"
                android:layout_marginTop="13dp"


                android:orientation="horizontal">




                <androidx.cardview.widget.CardView
                    android:layout_width="166dp"
                    android:layout_height="80dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="240dp"

                    android:tag="problem solved"
                    app:cardBackgroundColor="#9DC3E4C0"
                    app:cardCornerRadius="10dp"




                    >

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="9dp"
                        android:paddingTop="5dp"
                        android:text="Problem Solved"
                        android:textColor="#9E000000"


                        android:textStyle="bold" />


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="35dp"

                        android:paddingTop="28dp"
                        android:text="1,256"
                        android:textColor="#B1000000"
                        android:textSize="25dp"
                        android:textStyle="bold" />


                </androidx.cardview.widget.CardView>


                <androidx.cardview.widget.CardView
                    android:layout_width="166dp"
                    android:layout_height="80dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="240dp"

                    android:tag="problem solved"
                    app:cardBackgroundColor="#96B5E9C0"
                    app:cardCornerRadius="10dp"




                    >

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="9dp"
                        android:paddingTop="5dp"
                        android:text="Active Users"
                        android:textColor="#A9090808"


                        android:textStyle="bold" />


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="35dp"

                        android:paddingTop="28dp"
                        android:text="1,256"
                        android:textColor="#A6000000"
                        android:textSize="25dp"
                        android:textStyle="bold" />


                </androidx.cardview.widget.CardView>


            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:layout_marginTop="340dp"
                android:layout_marginLeft="20dp"
                android:textStyle="bold"
                android:text="Quick Actions"



                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="488dp"
                android:orientation="horizontal"


                >


                <androidx.cardview.widget.CardView
                    android:layout_width="102dp"
                    android:layout_height="93dp"
                    android:layout_marginLeft="34dp"
                    android:layout_marginTop="365dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="30dp"


                    >

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:src="@drawable/messgae"

                        />

                    <Button
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="58dp"
                        android:backgroundTint="@color/white"
                        android:paddingTop="0dp"
                        android:text="chat bot"
                        android:textAlignment="center"
                        android:textColor="@color/black"

                        />


                </androidx.cardview.widget.CardView>


                <androidx.cardview.widget.CardView
                    android:layout_width="102dp"
                    android:layout_height="93dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="365dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="30dp"


                    >

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:src="@drawable/donation"

                        />

                    <Button
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="58dp"
                        android:backgroundTint="@color/white"
                        android:paddingTop="0dp"
                        android:text="Donate"
                        android:textAlignment="center"
                        android:textColor="@color/black"

                        />


                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="102dp"
                    android:layout_height="93dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="365dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="30dp"


                    >

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:src="@drawable/issues"

                        />

                    <Button
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="58dp"
                        android:backgroundTint="@color/white"
                        android:paddingTop="0dp"
                        android:text="issues"
                        android:textAlignment="center"
                        android:textColor="@color/black"

                        />


                </androidx.cardview.widget.CardView>


            </LinearLayout>



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                />






            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/navigation"

                android:layout_marginTop="590dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:background="@android:color/white"
                app:menu="@layout/bottom_nav_menu"
                app:itemIconTint="@drawable/nav_item_color"
                app:itemTextColor="@drawable/nav_item_color"
                app:labelVisibilityMode="labeled"

                />













        </androidx.cardview.widget.CardView>










    </LinearLayout>
</LinearLayout>

